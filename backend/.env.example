# Example values only. This file is NOT automatically loaded.
# Set process environment variables in your shell before starting Uvicorn.
# PowerShell: $env:WILDFYRE_DATA_MODE = "sample"
# POSIX: export WILDFYRE_DATA_MODE=sample
# Default mode is live and requires a free NASA FIRMS map key:
# https://firms.modaps.eosdis.nasa.gov/api/area/
WILDFYRE_DATA_MODE=live
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
WILDFYRE_BBOX=-124.5,32.5,-114.0,42.1
WILDFYRE_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Live example (PowerShell): $env:FIRMS_MAP_KEY = "YOUR_MAP_KEY"
# Live example (POSIX): export FIRMS_MAP_KEY=YOUR_MAP_KEY

# Launcher sets REQUIRE_MODEL=1. Direct API defaults to visible unavailable fallback.
# WILDFYRE_REQUIRE_MODEL=1
# WILDFYRE_MODEL_ARTIFACT=/absolute/path/to/forest.json.gz
# WILDFYRE_MODEL_CONTRACT=/absolute/path/to/models/fire-persistence/model.json
